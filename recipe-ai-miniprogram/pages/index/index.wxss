/* ===== 首页 ===== */
.home-container {
  padding-top: 0;
}

/* 顶部导航 */
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: var(--surface-container-lowest);
}

.top-nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.top-nav-mine {
  width: 64rpx;
  height: 64rpx;
  background: var(--surface-container);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* 热门推荐 */
.popular-section {
  margin-bottom: 32rpx;
}

.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.popular-scroll {
  width: 100%;
}

.popular-list {
  display: flex;
  flex-direction: row;
  padding: 4rpx 8rpx;
  gap: 16rpx;
}

.popular-card {
  flex-shrink: 0;
  width: 280rpx;
  padding: 24rpx;
  background: var(--surface-container-lowest);
  border-radius: 20rpx;
  box-shadow: var(--shadow);
  border: 2rpx solid var(--outline-variant);
  transition: transform 0.2s;
}

.popular-card:active {
  transform: scale(0.96);
}

.popular-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.popular-card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.popular-card-views,
.popular-card-favs {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.popular-card-source {
  margin-top: 8rpx;
}

.popular-card-source .source-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

/* Hero区域 */
.hero-section {
  text-align: center;
  padding: 48rpx 0 40rpx;
}

.hero-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  display: inline-block;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  letter-spacing: -0.02em;
}

.hero-subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 输入卡片 */
.input-card {
  background: var(--surface-container-lowest);
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-card);
}

.input-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.input-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-icon {
  font-size: 28rpx;
}

.input-label-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.input-wrapper {
  position: relative;
  margin-bottom: 20rpx;
}

.url-input {
  width: 100%;
  min-height: 140rpx;
  padding: 24rpx 60rpx 24rpx 24rpx;
  border: 2rpx solid var(--outline-variant);
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: var(--surface-container-low);
  box-sizing: border-box;
  color: var(--text-primary);
}

.clear-btn {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 44rpx;
  height: 44rpx;
  background: var(--surface-dim);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.paste-row {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 24rpx;
}

.paste-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--surface-container);
  border: 2rpx solid var(--outline-variant);
}

.paste-icon {
  font-size: 24rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

.submit-btn[disabled] {
  opacity: 0.5;
}

/* 示例区域 */
.examples-section {
  margin-bottom: 32rpx;
}

.examples-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.examples-line {
  flex: 1;
  height: 2rpx;
  background: var(--surface-dim);
}

.examples-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  white-space: nowrap;
}

.example-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.example-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: var(--surface-container-lowest);
  border-radius: 20rpx;
  box-shadow: var(--shadow);
  transition: transform 0.2s;
}

.example-card:active {
  transform: scale(0.98);
}

.example-thumb {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, var(--surface-container-high) 0%, var(--surface-container) 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.example-thumb-icon {
  font-size: 40rpx;
}

.example-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.example-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.example-url {
  font-size: 24rpx;
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.example-arrow {
  font-size: 40rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 32rpx 0;
  padding: 20rpx 24rpx;
  background: var(--surface-container-low);
  border-radius: 16rpx;
}

.search-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  background: transparent;
  border: none;
  outline: none;
  padding: 0;
}

.search-clear {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  background: var(--surface-dim);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.search-result-section {
  margin: 24rpx 32rpx;
}

.search-loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}

.search-empty {
  text-align: center;
  padding: 40rpx;
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.search-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.search-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--surface-container-lowest);
  border-radius: 16rpx;
  box-shadow: var(--shadow);
  gap: 16rpx;
}

.search-card:active {
  transform: scale(0.98);
}

.search-card-body {
  flex: 1;
  min-width: 0;
}

.search-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-card-views,
.search-card-favs {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.search-card-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  font-weight: 300;
  flex-shrink: 0;
}

/* ===== Tab切换 ===== */
.tab-bar {
  display: flex;
  margin: 0 32rpx;
  background: var(--surface-container-low);
  border-radius: 16rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.tab-active {
  background: var(--surface-container-lowest);
  color: var(--primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(61, 47, 43, 0.06);
}

.tab-icon {
  font-size: 28rpx;
}

.tab-label {
  line-height: 1;
}

/* ===== 历史记录 ===== */
.history-section {
  margin-top: 32rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.history-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.history-empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.history-empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.history-empty-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-card {
  display: flex;
  align-items: center;
  background: var(--surface-container-lowest);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow);
  gap: 16rpx;
}

.history-card:active {
  transform: scale(0.98);
}

.history-card-body {
  flex: 1;
  min-width: 0;
}

.history-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-card-video {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.history-card-cal {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
}

.history-card-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.history-card-action {
  width: 52rpx;
  height: 52rpx;
  background: var(--surface-container);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.history-card-delete {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

/* ===== 底部提示 ===== */
.footer-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 0 48rpx;
}

.footer-icon {
  font-size: 28rpx;
}

.footer-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
