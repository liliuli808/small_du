.header {
  text-align: center;
  padding: 40rpx 0;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.input-card {
  padding: 32rpx;
}

.input-wrapper {
  position: relative;
  margin-bottom: 20rpx;
}

.url-input {
  min-height: 120rpx;
  padding-right: 60rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.clear-btn {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--bg-tertiary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.input-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.submit-btn {
  width: 100%;
}

.submit-btn.loading {
  opacity: 0.7;
}

.submit-btn[disabled] {
  opacity: 0.5;
}

.tips-card {
  padding: 32rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.tip-num {
  width: 36rpx;
  height: 36rpx;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.disclaimer {
  text-align: center;
  padding: 24rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}
