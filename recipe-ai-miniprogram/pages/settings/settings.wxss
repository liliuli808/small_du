.container {
  padding: 24rpx 32rpx 48rpx;
}

.form-section {
  margin-bottom: 32rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--outline-variant);
  border-radius: 16rpx;
  font-size: 28rpx;
  background: var(--surface-container-lowest);
  box-sizing: border-box;
  color: var(--text-primary);
}

.form-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  margin-top: 8rpx;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  background: var(--surface-container-lowest);
  border-radius: 20rpx;
  box-shadow: var(--shadow);
}

.menu-item:active {
  transform: scale(0.98);
}

.menu-icon {
  font-size: 36rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-container-low);
  border-radius: 16rpx;
}

.menu-body {
  flex: 1;
}

.menu-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.about-section {
  background: var(--surface-container-lowest);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
}

.about-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.about-row + .about-row {
  border-top: 2rpx solid var(--surface-container);
}

.about-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.about-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}
