/* ===== 结果页 ===== */
.result-container {
  padding-bottom: 0;
}

/* 加载/错误状态 */
.loading-container, .error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 24rpx;
  color: var(--text-secondary);
}

.loading-spinner-large {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--surface-dim);
  border-top-color: var(--primary-container);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.error-circle {
  width: 160rpx;
  height: 160rpx;
  background: var(--surface-container);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

/* 视频信息卡片 */
.video-info-card {
  display: flex;
  gap: 24rpx;
  background: var(--surface-container-lowest);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.video-thumb {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, var(--surface-container-high) 0%, var(--surface-container) 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.video-thumb-icon {
  font-size: 56rpx;
}

.video-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.video-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.video-meta-row {
  display: flex;
  gap: 24rpx;
}

.video-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.meta-icon {
  font-size: 22rpx;
}

.source-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.source-tag {
  padding: 6rpx 16rpx;
  background: var(--surface-container-low);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 菜谱标题 */
.dish-header-card {
  background: linear-gradient(135deg, var(--primary) 0%, #c43a00 100%);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-lg);
}

.dish-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
  letter-spacing: -0.01em;
}

.dish-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.servings-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
}

.servings-icon {
  font-size: 22rpx;
}

.uncertain-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: rgba(253, 192, 3, 0.25);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff8f0;
}

/* 收藏按钮 */
.dish-header-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.favorite-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  transition: all 0.2s;
  flex-shrink: 0;
}

.favorite-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.35);
}

.favorite-btn.loading {
  opacity: 0.6;
}

.favorite-icon {
  font-size: 36rpx;
}

.favorite-text {
  font-size: 20rpx;
  color: #fff;
}

/* 营养概览卡片 */
.nutrition-overview-card {
  background: var(--surface-container-lowest);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.nutrition-overview-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.overview-icon {
  font-size: 32rpx;
}

.nutrition-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.nutrition-cell {
  text-align: center;
  padding: 20rpx 12rpx;
  background: var(--surface-container-low);
  border-radius: 16rpx;
}

.nutrition-cell.total {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--surface-container) 100%);
}

.nutrition-cell.per {
  background: linear-gradient(135deg, #eaffe2 0%, var(--surface-container) 100%);
}

.nutrition-cell-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.nutrition-cell-value.protein {
  color: var(--secondary);
}

.nutrition-cell-value.fat {
  color: var(--tertiary);
}

.nutrition-cell-value.carbs {
  color: #5b7cfa;
}

.nutrition-cell-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.nutrition-hint {
  padding: 16rpx 20rpx;
  background: var(--surface-container-low);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
}

/* 通用区块 */
.ingredients-section,
.nutrition-detail-section,
.steps-section,
.tips-section {
  background: var(--surface-container-lowest);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.servings-tag {
  padding: 6rpx 16rpx;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 食材列表 */
.ingredients-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ingredient-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  transition: background 0.2s;
}

.ingredient-row:active {
  background: var(--surface-container-low);
}

.ingredient-check {
  padding-top: 4rpx;
}

.check-circle {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--outline);
  border-radius: 50%;
  flex-shrink: 0;
}

.ingredient-body {
  flex: 1;
  min-width: 0;
}

.ingredient-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.ingredient-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.ingredient-grams {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
}

.ingredient-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.ingredient-source {
  font-size: 24rpx;
  color: var(--text-tertiary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.confidence-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.confidence-badge.high {
  background: var(--secondary-light);
  color: var(--secondary);
}

.confidence-badge.medium {
  background: var(--tertiary-light);
  color: var(--tertiary);
}

.confidence-badge.low {
  background: #fef2f2;
  color: var(--error);
}

.confidence-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.confidence-dot.high {
  background: var(--secondary-container);
}

.confidence-dot.medium {
  background: var(--tertiary-container);
}

.confidence-dot.low {
  background: var(--error-container);
}

/* 热量明细 */
.nutrition-detail-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nutrition-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--surface-container-low);
  border-radius: 16rpx;
}

.nutrition-detail-row.unmatched {
  opacity: 0.5;
}

.detail-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.detail-values {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.detail-kcal {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
}

.detail-grams {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.detail-unmatched {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 烹饪步骤 */
.steps-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.step-row {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
}

.step-timeline {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, var(--primary-container) 0%, var(--primary) 100%);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.step-line {
  width: 3rpx;
  flex: 1;
  min-height: 40rpx;
  background: var(--surface-dim);
  margin: 8rpx 0;
}

.step-body {
  flex: 1;
  padding-bottom: 16rpx;
}

.step-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.step-desc-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.step-time-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: var(--surface-container);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.time-icon {
  font-size: 20rpx;
}

.step-techniques {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.technique-chip {
  padding: 8rpx 18rpx;
  background: #e8f0fe;
  color: #4a6cf7;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 烹饪技巧 */
.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.tip-bullet {
  width: 10rpx;
  height: 10rpx;
  background: var(--primary-container);
  border-radius: 50%;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.tip-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  flex: 1;
}

/* 数据来源 */
.data-source-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: var(--surface-container);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.source-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.source-value {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 底部 */
.bottom-spacer {
  height: 160rpx;
}
