<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text>正在加载菜谱...</text>
  </view>

  <!-- 错误 -->
  <view wx:if="{{error}}" class="error-container">
    <view class="error-icon">😞</view>
    <text>{{error}}</text>
    <view class="btn btn-primary" bindtap="goBack">返回首页</view>
  </view>

  <!-- 结果内容 -->
  <block wx:if="{{!loading && !error}}">
    <!-- 视频信息区 -->
    <view class="card video-card">
      <view class="video-title">{{video.title}}</view>
      <view class="video-meta">
        <text class="meta-item">👤 {{video.owner_name || '未知UP主'}}</text>
        <text class="meta-item">📺 B站</text>
      </view>
      <view class="source-tags">
        <view wx:for="{{textSources.source_types}}" wx:key="*this" class="tag tag-primary">
          {{item === 'subtitle' ? '字幕' : item === 'description' ? '简介' : item === 'top_comment' ? '置顶评论' : '高赞评论'}}
        </view>
      </view>
      <view wx:if="{{!textSources.has_subtitle}}" class="warning-text">
        ⚠️ 未找到可用字幕，已根据视频简介和评论生成菜谱，结果可能不完整。
      </view>
    </view>

    <!-- 菜名和份数 -->
    <view class="card dish-header">
      <view class="dish-name">{{recipe.dish_name}}</view>
      <view class="dish-servings">约 {{recipe.servings || 1}} 人份</view>
      <view wx:if="{{recipe.uncertain_items && recipe.uncertain_items.length > 0}}" class="uncertain-banner">
        <text wx:for="{{recipe.uncertain_items}}" wx:key="*this">⚠️ {{item}}
</text>
      </view>
    </view>

    <!-- 热量概览 -->
    <view class="card nutrition-card">
      <view class="card-title">
        <text class="icon">🔥</text>
        <text>热量分析</text>
      </view>
      <view class="nutrition-grid">
        <view class="nutrition-item total">
          <view class="nutrition-value">{{nutrition.total_kcal || 0}}</view>
          <view class="nutrition-label">整道菜 kcal</view>
        </view>
        <view class="nutrition-item per-serving">
          <view class="nutrition-value">{{nutrition.kcal_per_serving || 0}}</view>
          <view class="nutrition-label">每份 kcal</view>
        </view>
        <view class="nutrition-item">
          <view class="nutrition-value protein">{{nutrition.total_protein || 0}}g</view>
          <view class="nutrition-label">蛋白质</view>
        </view>
        <view class="nutrition-item">
          <view class="nutrition-value fat">{{nutrition.total_fat || 0}}g</view>
          <view class="nutrition-label">脂肪</view>
        </view>
        <view class="nutrition-item">
          <view class="nutrition-value carbs">{{nutrition.total_carbs || 0}}g</view>
          <view class="nutrition-label">碳水</view>
        </view>
      </view>
      <view class="nutrition-disclaimer">
        ⚠️ 该结果为估算值，实际热量会受用油量、食材品牌和烹饪损耗影响。
      </view>
    </view>

    <!-- 材料清单 -->
    <view class="card ingredients-card">
      <view class="card-title flex-between">
        <view class="flex-center gap-8">
          <text class="icon">🥬</text>
          <text>材料清单</text>
        </view>
        <view class="btn btn-secondary btn-sm" bindtap="goEditIngredients">✏️ 修改用量</view>
      </view>
      <view class="ingredients-list">
        <view wx:for="{{recipe.ingredients}}" wx:key="index" class="ingredient-item">
          <view class="ingredient-main">
            <text class="ingredient-name">{{item.name}}</text>
            <text class="ingredient-grams">{{item.grams}}g</text>
          </view>
          <view class="ingredient-detail">
            <text class="ingredient-original">原文：{{item.source_text || item.amount + item.unit}}</text>
            <view class="ingredient-meta">
              <text class="source">来源：{{item.source === 'subtitle' ? '字幕' : item.source === 'description' ? '简介' : item.source === 'top_comment' ? '置顶评论' : '评论'}}</text>
              <view class="confidence {{item.confidence >= 0.8 ? 'high' : item.confidence >= 0.5 ? 'medium' : 'low'}}">
                {{item.confidence >= 0.8 ? '置信度：高' : item.confidence >= 0.5 ? '置信度：中' : '置信度：低'}}
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 热量明细 -->
    <view class="card nutrition-detail-card" wx:if="{{nutrition.details && nutrition.details.length > 0}}">
      <view class="card-title">
        <text class="icon">📊</text>
        <text>热量明细</text>
      </view>
      <view class="nutrition-detail-list">
        <view wx:for="{{nutrition.details}}" wx:key="index" class="nutrition-detail-item {{item.matched ? '' : 'unmatched'}}">
          <view class="detail-name">{{item.name}}</view>
          <view class="detail-value" wx:if="{{item.matched}}">
            <text>{{item.kcal}} kcal</text>
            <text class="detail-sub">{{item.grams}}g</text>
          </view>
          <view class="detail-value" wx:else>
            <text class="unmatched-text">未匹配营养数据</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 做菜步骤 -->
    <view class="card steps-card">
      <view class="card-title">
        <text class="icon">👨‍🍳</text>
        <text>做菜步骤</text>
      </view>
      <view class="steps-list">
        <view wx:for="{{recipe.steps}}" wx:key="index" class="step-item">
          <view class="step-number">{{item.order}}</view>
          <view class="step-content">
            <view class="step-title">{{item.title}}</view>
            <view class="step-desc">{{item.description}}</view>
            <view class="step-meta" wx:if="{{item.start_time || item.end_time}}">
              <text class="step-time">⏱ {{item.start_time ? (item.start_time/60).toFixed(0) + ':' + (item.start_time%60).toFixed(0).padStart(2,'0') : '00:00'}} - {{item.end_time ? (item.end_time/60).toFixed(0) + ':' + (item.end_time%60).toFixed(0).padStart(2,'0') : '00:00'}}</text>
            </view>
            <view class="step-techniques" wx:if="{{item.techniques && item.techniques.length > 0}}">
              <view wx:for="{{item.techniques}}" wx:for-item="tech" wx:key="*this" class="technique-tag">{{tech}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 烹饪技巧 -->
    <view class="card tips-card" wx:if="{{recipe.tips && recipe.tips.length > 0}}">
      <view class="card-title">
        <text class="icon">💡</text>
        <text>烹饪技巧</text>
      </view>
      <view class="tips-content">
        <view wx:for="{{recipe.tips}}" wx:key="*this" class="tip-text">• {{item}}</view>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="bottom-actions">
      <view class="btn btn-primary" bindtap="goBack">🏠 返回首页</view>
    </view>
  </block>
</view>
