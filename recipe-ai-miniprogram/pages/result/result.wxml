<view class="container result-container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner-large"></view>
    <text class="loading-text">正在加载菜谱...</text>
  </view>

  <!-- 错误 -->
  <view wx:if="{{error}}" class="error-container">
    <view class="error-circle">😞</view>
    <text class="error-text">{{error}}</text>
    <view class="btn btn-primary" bindtap="goBack">返回首页</view>
  </view>

  <!-- 结果内容 -->
  <block wx:if="{{!loading && !error}}">
    <!-- 视频信息卡片 -->
    <view class="video-info-card">
      <view class="video-thumb">
        <image wx:if="{{video.cover_url}}" class="video-thumb-img" src="{{video.cover_url}}" mode="aspectFill" />
        <text wx:else class="video-thumb-icon">🎬</text>
      </view>
      <view class="video-info">
        <view class="video-title">{{video.title || '未知视频'}}</view>
        <view class="video-meta-row">
          <view class="video-meta-item">
            <text class="meta-icon">👤</text>
            <text>{{video.owner_name || '未知UP主'}}</text>
          </view>
          <view class="video-meta-item">
            <text class="meta-icon">⏱</text>
            <text>{{formatTime(video.duration)}}</text>
          </view>
        </view>
        <view class="source-tags-row">
          <view wx:for="{{textSources.source_types}}" wx:key="*this" class="source-tag">
            {{item === 'subtitle' ? '字幕' : item === 'description' ? '简介' : item === 'top_comment' ? '置顶评论' : '高赞评论'}}
          </view>
        </view>
      </view>
    </view>

    <!-- 菜谱标题区 -->
    <view class="dish-header-card">
      <view class="dish-header-top">
        <view class="dish-name">{{recipe.dish_name || '未命名菜谱'}}</view>
        <view class="favorite-btn {{isFavorited ? 'favorited' : ''}} {{favoriteLoading ? 'loading' : ''}}" bindtap="toggleFavorite">
          <text class="favorite-icon">{{isFavorited ? '❤️' : '🤍'}}</text>
          <text class="favorite-text">{{isFavorited ? '已收藏' : '收藏'}}</text>
        </view>
      </view>
      <view class="dish-meta">
        <view class="servings-badge">
          <text class="servings-icon">🍽</text>
          <text>约 {{recipe.servings || 1}} 人份</text>
        </view>
        <view wx:if="{{recipe.uncertain_items && recipe.uncertain_items.length > 0}}" class="uncertain-badge">
          <text>⚠️ 部分食材不确定</text>
        </view>
      </view>
    </view>

    <!-- 营养概览卡片 -->
    <view class="nutrition-overview-card">
      <view class="nutrition-overview-title">
        <text class="overview-icon">🔥</text>
        <text>营养概览</text>
      </view>
      <view class="nutrition-grid">
        <view class="nutrition-cell total">
          <view class="nutrition-cell-value">{{nutrition.total_kcal || 0}}</view>
          <view class="nutrition-cell-label">整道菜 kcal</view>
        </view>
        <view class="nutrition-cell per">
          <view class="nutrition-cell-value">{{nutrition.kcal_per_serving || 0}}</view>
          <view class="nutrition-cell-label">每份 kcal</view>
        </view>
        <view class="nutrition-cell">
          <view class="nutrition-cell-value protein">{{nutrition.total_protein || 0}}g</view>
          <view class="nutrition-cell-label">蛋白质</view>
        </view>
        <view class="nutrition-cell">
          <view class="nutrition-cell-value fat">{{nutrition.total_fat || 0}}g</view>
          <view class="nutrition-cell-label">脂肪</view>
        </view>
        <view class="nutrition-cell">
          <view class="nutrition-cell-value carbs">{{nutrition.total_carbs || 0}}g</view>
          <view class="nutrition-cell-label">碳水</view>
        </view>
      </view>
      <view class="nutrition-hint">
        <text>⚠️ 该结果为估算值，实际热量会受用油量、食材品牌和烹饪损耗影响</text>
      </view>
    </view>

    <!-- 食材清单 -->
    <view class="ingredients-section">
      <view class="section-header flex-between">
        <view class="flex-center gap-8">
          <text class="section-icon">🥬</text>
          <text class="section-title">食材清单</text>
          <view class="servings-tag">{{recipe.servings || 1}}人份</view>
        </view>
        <view class="btn btn-primary btn-xs" bindtap="goEditIngredients">⚖️ 调整份量</view>
      </view>

      <view class="ingredients-list">
        <view wx:for="{{recipe.ingredients}}" wx:key="index" class="ingredient-row">
          <view class="ingredient-check">
            <view class="check-circle"></view>
          </view>
          <view class="ingredient-body">
            <view class="ingredient-top">
              <text class="ingredient-name">{{item.name}}</text>
              <text class="ingredient-grams">{{item.grams}}g</text>
            </view>
            <view class="ingredient-bottom">
              <text class="ingredient-source">{{item.source_text || item.amount + item.unit}}</text>
              <view class="confidence-badge {{formatConfidence(item.confidence).class}}">
                <view class="confidence-dot {{formatConfidence(item.confidence).class}}"></view>
                <text>{{formatConfidence(item.confidence).text}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 热量明细 -->
    <view class="nutrition-detail-section" wx:if="{{nutrition.details && nutrition.details.length > 0}}">
      <view class="section-header">
        <text class="section-icon">📊</text>
        <text class="section-title">热量明细</text>
      </view>
      <view class="nutrition-detail-list">
        <view wx:for="{{nutrition.details}}" wx:key="index" class="nutrition-detail-row {{item.matched ? '' : 'unmatched'}}">
          <view class="detail-name">{{item.name}}</view>
          <view class="detail-values" wx:if="{{item.matched}}">
            <text class="detail-kcal">{{item.kcal}} kcal</text>
            <text class="detail-grams">{{item.grams}}g</text>
          </view>
          <view class="detail-unmatched" wx:else>
            <text>未匹配营养数据</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 烹饪步骤 -->
    <view class="steps-section">
      <view class="section-header">
        <text class="section-icon">👨‍🍳</text>
        <text class="section-title">烹饪步骤</text>
      </view>
      <view class="steps-list">
        <view wx:for="{{recipe.steps}}" wx:key="index" class="step-row">
          <view class="step-timeline">
            <view class="step-number">{{item.order}}</view>
            <view wx:if="{{index < recipe.steps.length - 1}}" class="step-line"></view>
          </view>
          <view class="step-body">
            <view class="step-title-text">{{item.title}}</view>
            <view class="step-desc-text">{{item.description}}</view>
            <view class="step-time-badge" wx:if="{{item.start_time || item.end_time}}">
              <text class="time-icon">⏱</text>
              <text wx:if="{{item.start_time && item.end_time}}">{{formatTime(item.start_time)}} - {{formatTime(item.end_time)}}</text>
              <text wx:elif="{{item.start_time}}">{{formatTime(item.start_time)}}</text>
              <text wx:else>{{formatTime(item.end_time)}}</text>
            </view>
            <view class="step-techniques" wx:if="{{item.techniques && item.techniques.length > 0}}">
              <view wx:for="{{item.techniques}}" wx:for-item="tech" wx:key="*this" class="technique-chip">{{tech}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 烹饪技巧 -->
    <view class="tips-section" wx:if="{{recipe.tips && recipe.tips.length > 0}}">
      <view class="section-header">
        <text class="section-icon">💡</text>
        <text class="section-title">烹饪技巧</text>
      </view>
      <view class="tips-list">
        <view wx:for="{{recipe.tips}}" wx:key="*this" class="tip-row">
          <view class="tip-bullet"></view>
          <text class="tip-content">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 数据来源 -->
    <view class="data-source-bar">
      <text class="source-label">数据来源</text>
      <text class="source-value">{{textSources.has_subtitle ? '视频字幕 + AI识别解析' : '视频简介/评论 + AI识别解析'}}</text>
    </view>

    <!-- 底部间距 -->
    <view class="bottom-spacer"></view>
  </block>

  <!-- 底部固定按钮 -->
  <view wx:if="{{!loading && !error}}" class="bottom-bar">
    <view class="btn btn-secondary" bindtap="goEditRecipe">✏️ 编辑菜谱</view>
    <button class="btn btn-ghost share-btn" open-type="share">📤 分享</button>
    <view class="btn btn-primary" bindtap="goBack">🏠 返回首页</view>
  </view>
</view>
