.detail-container {
  padding-top: 0;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: var(--surface-container-lowest);
}

.back-btn {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-action {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

.header-action.delete {
  color: var(--error);
}

/* 加载 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--surface-dim);
  border-top-color: var(--primary-container);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 菜名 */
.dish-header-card {
  background: linear-gradient(135deg, var(--primary) 0%, #c43a00 100%);
  border-radius: 24rpx;
  padding: 36rpx;
  margin: 24rpx;
  box-shadow: var(--shadow-lg);
}

.dish-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
  letter-spacing: -0.01em;
}

.dish-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.servings-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
}

.date-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 详情区块 */
.detail-section {
  background: var(--surface-container-lowest);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: var(--shadow-card);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 食材 */
.ingredients-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--surface-container-low);
  border-radius: 12rpx;
}

.ingredient-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.ingredient-amount {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 步骤 */
.steps-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
}

.step-timeline {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, var(--primary-container) 0%, var(--primary) 100%);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.step-line {
  width: 3rpx;
  flex: 1;
  min-height: 40rpx;
  background: var(--surface-dim);
  margin: 8rpx 0;
}

.step-body {
  flex: 1;
  padding-bottom: 16rpx;
}

.step-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 小贴士 */
.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.tip-bullet {
  width: 10rpx;
  height: 10rpx;
  background: var(--primary-container);
  border-radius: 50%;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.tip-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  flex: 1;
}

.bottom-spacer {
  height: 40rpx;
}