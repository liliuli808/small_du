.edit-container {
  padding-top: 0;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: var(--surface-container-lowest);
}

.back-btn {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
}

.back-btn-placeholder {
  width: 80rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 表单区块 */
.form-section {
  margin: 24rpx;
  padding: 28rpx;
  background: var(--surface-container-lowest);
  border-radius: 20rpx;
  box-shadow: var(--shadow);
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--outline-variant);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--surface-container-low);
  box-sizing: border-box;
}

.form-picker {
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--outline-variant);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--surface-container-low);
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--outline-variant);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--surface-container-low);
  box-sizing: border-box;
  line-height: 1.6;
}

.tips-textarea {
  min-height: 200rpx;
}

/* 食材 */
.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ingredient-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.ingredient-num {
  width: 40rpx;
  height: 40rpx;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.ingredient-fields {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ingredient-name-input {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.ingredient-amount-row {
  display: flex;
  gap: 12rpx;
}

.ingredient-amount-input {
  flex: 1;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.unit-picker {
  width: 120rpx;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

/* 步骤 */
.step-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.step-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.step-fields {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.step-title-input {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

/* 删除按钮 */
.remove-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--error);
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

/* 底部 */
.bottom-spacer {
  height: 160rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--surface-container-lowest);
  border-top: 2rpx solid var(--outline-variant);
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 20rpx;
}