.user-recipes-container {
  padding-top: 0;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: var(--surface-container-lowest);
}

.back-btn {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.create-btn {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  padding: 8rpx 16rpx;
  background: var(--primary-light);
  border-radius: 999rpx;
}

/* 加载 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--surface-dim);
  border-top-color: var(--primary-container);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 菜谱列表 */
.recipes-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recipe-card {
  background: var(--surface-container-lowest);
  border-radius: 20rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.recipe-main {
  padding: 28rpx;
}

.recipe-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.recipe-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.recipe-actions {
  display: flex;
  border-top: 2rpx solid var(--surface-container-low);
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  font-size: 26rpx;
}

.action-btn.edit {
  color: var(--primary);
  background: var(--surface-container-low);
}

.action-btn.delete {
  color: var(--error);
  background: var(--surface-container-low);
}

.action-btn:active {
  background: var(--surface-container);
}