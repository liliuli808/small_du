.favorites-container {
  padding-top: 0;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: var(--surface-container-lowest);
}

.back-btn {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
}

.back-btn-placeholder {
  width: 80rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 加载 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--surface-dim);
  border-top-color: var(--primary-container);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 收藏列表 */
.favorites-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.favorite-card {
  background: var(--surface-container-lowest);
  border-radius: 20rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.favorite-main {
  padding: 28rpx;
}

.favorite-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.favorite-source {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.source-tag {
  font-size: 24rpx;
}

.source-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.meta-item {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.favorite-actions {
  display: flex;
  border-top: 2rpx solid var(--surface-container-low);
}

.unfavorite-btn {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--error);
  background: var(--surface-container-low);
}

.unfavorite-btn:active {
  background: var(--surface-container);
}