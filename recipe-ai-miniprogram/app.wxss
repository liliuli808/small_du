page {
  --primary: #ad3500;
  --primary-container: #fc6b38;
  --primary-light: #fff1ed;
  --on-primary: #fff7f5;

  --secondary: #006f1d;
  --secondary-container: #94f990;
  --secondary-light: #eaffe2;

  --tertiary: #795a00;
  --tertiary-container: #fdc003;
  --tertiary-light: #fff8f0;

  --background: #fff8f6;
  --surface: #fff8f6;
  --surface-container-lowest: #ffffff;
  --surface-container-low: #fff1ed;
  --surface-container: #fee9e3;
  --surface-container-high: #fae4dd;
  --surface-container-highest: #f6ddd6;
  --surface-dim: #edd5ce;

  --text-primary: #3e2f2b;
  --text-secondary: #6d5b56;
  --text-tertiary: #8a7671;
  --text-on-primary: #fff7f5;

  --outline: #c3ada7;
  --outline-variant: #edd5ce;

  --success: #006f1d;
  --success-container: #94f990;
  --warning: #795a00;
  --warning-container: #fdc003;
  --error: #a83836;
  --error-container: #fa746f;

  --shadow: 0 2rpx 16rpx rgba(61, 47, 43, 0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(61, 47, 43, 0.1);
  --shadow-card: 0 4rpx 20rpx rgba(61, 47, 43, 0.08);

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  background-color: var(--background);
  color: var(--text-primary);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ===== 布局 ===== */
.container {
  padding: 24rpx 32rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 卡片 ===== */
.card {
  background: var(--surface-container-lowest);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.card-flat {
  background: var(--surface-container-low);
  border-radius: 20rpx;
  padding: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-title-small {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 48rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #fc6b38 0%, #ad3500 100%);
  color: var(--text-on-primary);
  box-shadow: 0 4rpx 16rpx rgba(173, 53, 0, 0.25);
}

.btn-primary[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.btn-secondary {
  background: var(--surface-container-low);
  color: var(--text-primary);
  border: 2rpx solid var(--outline-variant);
}

.btn-ghost {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary-container);
}

.btn-sm {
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.btn-xs {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border-radius: 10rpx;
}

.btn-icon {
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 50%;
  font-size: 32rpx;
}

/* ===== 输入框 ===== */
.input {
  width: 100%;
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--outline-variant);
  border-radius: 16rpx;
  font-size: 28rpx;
  background: var(--surface-container-lowest);
  box-sizing: border-box;
  color: var(--text-primary);
}

.input:focus {
  border-color: var(--primary-container);
}

/* ===== 标签/徽章 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background: var(--primary-light);
  color: var(--primary);
}

.tag-success {
  background: var(--secondary-light);
  color: var(--secondary);
}

.tag-warning {
  background: var(--tertiary-light);
  color: var(--tertiary);
}

.tag-error {
  background: #fee2e2;
  color: var(--error);
}

.tag-elevated {
  background: var(--surface-container-lowest);
  box-shadow: var(--shadow);
}

/* ===== 工具类 ===== */
.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.gap-8 {
  gap: 16rpx;
}

.gap-12 {
  gap: 24rpx;
}

.text-secondary {
  color: var(--text-secondary);
}

.text-tertiary {
  color: var(--text-tertiary);
}

.text-primary-color {
  color: var(--primary);
}

.text-center {
  text-align: center;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

/* ===== 加载动画 ===== */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--surface-dim);
  border-top-color: var(--primary-container);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ===== 底部固定栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--surface-container-lowest);
  border-top: 2rpx solid var(--surface-container);
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(61, 47, 43, 0.05);
  z-index: 100;
}

.bottom-bar .btn {
  flex: 1;
}

.bottom-bar-spacer {
  height: 140rpx;
}

/* ===== 分割线 ===== */
.divider {
  height: 2rpx;
  background: var(--surface-container);
  margin: 24rpx 0;
}

/* ===== 状态条 ===== */
.status-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.status-dot.high {
  background: var(--secondary-container);
}

.status-dot.medium {
  background: var(--tertiary-container);
}

.status-dot.low {
  background: var(--error-container);
}
